{
  "name": "@owdproject/react-theme-win95",
  "version": "4.0.0-alpha.4",
  "description": "Windows 95 theme for Open Web Desktop built with React, @owdproject/core and @owdproject/react.",
  "license": "MIT",
  "author": {
    "name": "Diego Villa",
    "url": "https://github.com/dxlliv"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@owdproject/core": "^4.0.0-alpha.3",
    "@owdproject/react-kit-react95": "^4.0.0-alpha.3",
    "@owdproject/react": "^4.0.0-alpha.3",
    "@react95/icons": "^2.8.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~6.0.3",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
